/build/
/build-lint/
/result
.direnv/

# Android (Quest client)
/client/quest/.android-sdk/
/client/quest/local.properties
/client/quest/app/build/
/client/quest/app/.cxx/
/client/quest/.gradle/
/client/quest/build/
# Vendored third-party SDKs (regenerated by client/quest/fetch-*.sh)
/third_party/

# Flatpak: the manifests under flatpak/ are tracked; only the build cache and
# the generated single-file bundles are ignored.
/.flatpak-builder
*.flatpak
/files.zip

/.deps/
/build-*/
/test-output/
/dist/

# Release secrets and generated packaging inputs stay outside Git.
*.jks
*.keystore
*.p12
*.pem
/signing/
/release-work/

# Isolated AppImage build inputs and intermediate artifacts
/.release-work/

# Python checks do not belong to source releases
__pycache__/
*.pyc
